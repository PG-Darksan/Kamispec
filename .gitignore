build/
.dart_tool/
.android/
.ios/
# 環境変数ファイル（API キーが入っているので絶対にコミットしない）
env.json
env.*.json
.env
.env.*
# ★ 控え (バックアップ) も必ず除外する。
#   `env.json` と `env.*.json` だけでは `env.json.bak_pricechange` のような
#   名前が素通りし、 `git add -A` で公開リポジトリに載ってしまう
#   (= 実際に取りこぼしを発見。 中身は Gemini / OAuth / RevenueCat の実キー)。
env.json*
env.*
*.env

# 別リポジトリ/ローカル成果物 (ロールバック用チェックポイントには含めない)
Kamispec/
# 手元の控えと調査メモ。 公開リポジトリなので、 うっかり git add -A した時に
#   載らないよう先に塞いでおく (中身に実キーの写しが混ざっている事がある)。
backups/
_debug_docs/
.local_flutter/
# ビルド成果物の保管先。 GitHub Releases にも上げているので git には入れない
#   (= 1 回 100MB 超 × 回数ぶん、 リポジトリが肥大化する)。
releases/
# Gradle のビルドキャッシュ。 executionHistory.bin だけで 78MB あり、 ビルドの
#   たびに中身が変わるため、 コミットするとリポジトリが一気に膨らむ
#   (= .git が 36GB になった主因)。 再生成されるので追跡しない。
android/.gradle/
.gradle/
*.log
build_apk.log
.idea/
.vscode/
*.iml

# Stripe Webhook 署名シークレット (Worker へ設定済み。コミットしない)
worker/_whsec.txt

# ── 鍵・資格情報の一般形 (先回りして塞ぐ) ──────────────────────────
#   ここに挙げた物は「まだ置いていなくても」 置いた瞬間に除外されるように
#   しておく。 公開リポジトリなので、 一度でも push すると取り消せない。
# Android の署名鍵とそのパスワード (key.properties.example は追跡してよい)
android/key.properties
key.properties
*.jks
*.keystore
# 証明書・秘密鍵
*.pem
*.p12
*.pfx
*.key
# サービスアカウント / 各種資格情報の JSON
service-account*.json
*credentials*.json
secrets.json
# 秘密を含みがちな控え全般 (バックアップ・退避)
*.bak_*
*secret*.txt
*token*.txt

# WACK (ストア審査の事前検査) の作業一式。証明書と 74MB の msix を含むので上げない。
# WACK の作業フォルダー。 スクリプトは tool/msix/ に置いて追跡する
#   (= マシンを失うと手順が消えるため)。 ここには成果物と鍵だけ残す。
wack/*.msix
wack/*.pfx
wack/wack_report.*
wack/*.xml

