rules_version = '2';

// ════════════════════════════════════════════════════════════════════════
//  Kamispec / MokuMoku  Firestore セキュリティルール (雛形)
// ════════════════════════════════════════════════════════════════════════
//
// 目的: 課金プラン (users/{uid}.plan 等) を「サーバー(Cloud Function = Admin
//   SDK)だけが書ける」 ようにし、 アプリ(クライアント)からは変更できなくする。
//   Admin SDK の書き込みはルールを完全にバイパスするので、 Cloud Function は
//   このルールに関係なく plan を更新できる。
//
// ⚠️ 重要な前提:
//   - このアプリは匿名認証 (request.auth.uid = 匿名localId)。
//   - これを deploy すると、 ここに列挙していないコレクションへの
//     クライアントアクセスは「すべて拒否」されます (Firestore は
//     デフォルト拒否)。 既存機能を壊さないよう、 既知のコレクションを
//     下に列挙しています。 もし弾かれる箇所があれば、 該当 match を追加し、
//     必ず先にテスト環境 (エミュレータ/別プロジェクト) で確認してください。
//   - 本番では各 match の "if request.auth != null" を、 所有者チェックや
//     グループメンバーチェックへ段階的に厳格化してください
//     (CLAUDE.md の「クライアント側セキュリティのみ」 警告を参照)。
//
// プラン移行メモ:
//   plan をロックすると、 アプリ側で plan を users ドキュメントへ書いていた
//   経路 (RevenueCat 反映ミラー・クーポン・ライセンス・dev) はその書き込みが
//   拒否されます。 ただし現在の課金判定 (currentPlan) はローカル(prefs)基準
//   なので、 端末の有料機能ロック自体は影響を受けません。 グループ表示用の
//   users.plan は今後 Cloud Function が正本として更新します。

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isDeveloper() {
      return signedIn() && request.auth.token.developer == true;
    }

    function isGroupHost(gid) {
      return signedIn()
        && get(/databases/$(database)/documents/groups/$(gid)).data.host
             == request.auth.uid;
    }

    function isGroupMember(gid) {
      return signedIn()
        && exists(/databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid));
    }

    // ── 課金で保護するフィールド ──
    function billingFields() {
      return [
        'plan',
        'subscriptionStatus',
        'planExpiresAt',
        'stripeCustomerId',
        'stripeSubscriptionId',
        'planSource',
        'planUpdatedAt'
      ];
    }

    // 受信データに課金フィールドが「一切含まれていない」か
    function noBillingFieldsIncoming() {
      return !request.resource.data.keys().hasAny(billingFields());
    }

    // 既存値と課金フィールドが「変化していない」か (作成時は resource==null
    //   なので呼ばない。 update 専用)
    function billingUnchanged() {
      return request.resource.data.get('plan', null)
                == resource.data.get('plan', null)
        && request.resource.data.get('subscriptionStatus', null)
                == resource.data.get('subscriptionStatus', null)
        && request.resource.data.get('planExpiresAt', null)
                == resource.data.get('planExpiresAt', null)
        && request.resource.data.get('stripeCustomerId', null)
                == resource.data.get('stripeCustomerId', null)
        && request.resource.data.get('stripeSubscriptionId', null)
                == resource.data.get('stripeSubscriptionId', null)
        && request.resource.data.get('planSource', null)
                == resource.data.get('planSource', null);
    }

    // ── users/{uid}: 本人のみ。 課金フィールドはクライアント書き込み不可 ──
    match /users/{uid} {
      allow read: if request.auth != null
                  && (request.auth.uid == uid || isDeveloper());

      // 新規作成: 本人。 ただし課金フィールドは付けられない
      //   (= 自分を pro/max にして作る、 を防ぐ)。
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && noBillingFieldsIncoming();

      // 更新: 本人。 課金フィールドは「現状と同じ値」 でなければ拒否
      //   (= displayName 等は変更可、 plan 等は変えられない)。
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && billingUnchanged();

      allow delete: if false;
    }

    // ── グループ (ページ/メンバー/カレンダー) ──
    // グループコードを知る認証ユーザーはメタ情報を GET して参加できる。
    // ページと予定の本文は、参加登録後のメンバー/ホストだけに限定する。
    match /groups/{gid} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
                    && request.resource.data.host == request.auth.uid;
      allow update, delete: if isGroupHost(gid);

      match /members/{memberUid} {
        allow read: if isGroupMember(gid) || isGroupHost(gid);
        allow create: if signedIn()
                      && memberUid == request.auth.uid
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.keys().hasOnly([
                           'uid', 'displayName', 'lastSeen',
                           'allowCalendarSharing'
                         ])
                      && exists(/databases/$(database)/documents/groups/$(gid));
        allow update: if signedIn()
                      && memberUid == request.auth.uid
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly([
                             'uid', 'displayName', 'lastSeen',
                             'allowCalendarSharing'
                           ]);
        allow delete: if signedIn()
                      && (memberUid == request.auth.uid || isGroupHost(gid));
      }

      match /pages/{pageId} {
        allow read, create: if isGroupMember(gid) || isGroupHost(gid);
        allow update, delete: if (isGroupMember(gid) || isGroupHost(gid))
          && (resource.data.get('uploadRestricted', false) != true
              || resource.data.get('restrictedByUid', '') == request.auth.uid);
      }

      match /calendar/{ownerUid} {
        allow read: if isGroupMember(gid) || isGroupHost(gid);
        allow create, update, delete: if signedIn()
                                     && ownerUid == request.auth.uid
                                     && (isGroupMember(gid) || isGroupHost(gid));
      }
    }

    // ── メッセージ ── 暫定: 認証済みなら可 (アプリ側で送受信フィルタ)。
    //   TODO(本番): fromUid==自分 / 宛先が自分 or 自分のグループ で絞る。
    match /messages/{msgId} {
      allow read, write: if request.auth != null;
    }

    // ── 問い合わせ ── 本人と developer のみ閲覧。返信改変は developer 限定。
    match /inquiries/{msgId} {
      allow get: if isDeveloper()
                 || (signedIn() && resource.data.uid == request.auth.uid);
      allow list: if isDeveloper();
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.reply == ''
                    && request.resource.data.status == 'open';
      allow update: if isDeveloper();
      allow delete: if isDeveloper()
                    || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // ── 管理設定 ── API キー等を含み得るため developer claim 限定。
    match /admin/{docId} {
      allow read, write: if isDeveloper();
    }

    // ── クーポン ──
    // 一覧・管理は developer claim のみ。通常ユーザーは入力したコードだけ GET。
    // currentUses は +1 だけ許可し、同時更新時には後続書込がルールで失敗する。
    match /coupons/{code} {
      allow get: if signedIn();
      allow list: if isDeveloper();
      allow create, delete: if isDeveloper();
      allow update: if isDeveloper()
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['currentUses', 'lastRedemptionId'])
            && request.resource.data.currentUses
                 == resource.data.get('currentUses', 0) + 1
            && request.resource.data.lastRedemptionId is string
            && !exists(/databases/$(database)/documents/coupons/$(code)/redemptions/$(request.resource.data.lastRedemptionId))
            && getAfter(/databases/$(database)/documents/coupons/$(code)/redemptions/$(request.resource.data.lastRedemptionId)).data.uid
                 == request.auth.uid
            && getAfter(/databases/$(database)/documents/coupons/$(code)/redemptions/$(request.resource.data.lastRedemptionId)).data.atomicVersion
                 == 1
            && (resource.data.get('maxUses', 0) == 0
                || request.resource.data.currentUses
                     <= resource.data.maxUses));

      match /redemptions/{deviceId} {
        allow get: if signedIn();
        allow list, delete, update: if isDeveloper();
        allow create: if signedIn()
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.atomicVersion == 1
                      && request.resource.data.validMonthsAfterUse
                           == get(/databases/$(database)/documents/coupons/$(code)).data
                                .get('validMonthsAfterUse', 0)
                      && getAfter(/databases/$(database)/documents/coupons/$(code)).data.currentUses
                           == get(/databases/$(database)/documents/coupons/$(code)).data
                                .get('currentUses', 0) + 1
                      && (request.resource.data.validMonthsAfterUse == 0
                          || (request.resource.data.benefitExpiresAt is timestamp
                              && request.resource.data.benefitExpiresAt > request.time
                              && request.resource.data.benefitExpiresAt
                                   <= request.time + duration.value(
                                        request.resource.data.validMonthsAfterUse * 32,
                                        'd')));
      }
    }

    // ── ライセンス ──
    // 発行元のサーバー正本 plan と一致する購入ライセンスだけ作成可能。
    // 消費時は entitlement 本文を不変にし、現在 UID を最大1件だけ追加する。
    match /licenses/{code} {
      allow get: if signedIn();
      allow list, delete: if false;
      allow create: if signedIn()
                    && request.resource.data.sourceUid == request.auth.uid
                    && request.resource.data.proSubscribed == true
                    && request.resource.data.plan in ['pro', 'max']
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.plan
                         == request.resource.data.plan
                    && request.resource.data.expiresAt > request.time
                    && request.resource.data.expiresAt
                         <= request.time + duration.value(8, 'd');
      allow update: if signedIn()
                    && resource.data.get('sourceWasDev', false) != true
                    && resource.data.expiresAt > request.time
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['consumedByUids', 'consumedByDeviceIds',
                                   'lastConsumedAt'])
                    && request.resource.data.get('consumedByUids', [])
                         .hasAll(resource.data.get('consumedByUids', []))
                    && request.auth.uid
                         in request.resource.data.get('consumedByUids', [])
                    && request.resource.data.get('consumedByUids', []).size()
                         <= resource.data.get('consumedByUids', []).size() + 1
                    && request.resource.data.get('consumedByUids', []).size()
                         + (resource.data.get('consumedByUid', '') == '' ? 0 : 1)
                         <= 4
                    && request.resource.data.get('consumedByDeviceIds', [])
                         .hasAll(resource.data.get('consumedByDeviceIds', []))
                    && request.resource.data.get('consumedByDeviceIds', []).size()
                         <= resource.data.get('consumedByDeviceIds', []).size() + 1
                    && request.resource.data.get('consumedByDeviceIds', []).size() <= 4;
    }

    // ── 上記以外は既定で拒否 ──
    //   (ここに無いコレクションにアクセスして弾かれたら、 その match を
    //    追加してください。 デプロイ前にエミュレータで動作確認推奨。)
  }
}
